# Copie ce fichier en .env puis adapte les valeurs.
# docker compose lit automatiquement le fichier .env.

# Le port côté machine est fixé à 3007 dans docker-compose.yml
# (http://localhost:3007). Change-le là-bas si besoin, pas ici.

# Mot de passe VISITEUR (celui intégré dans les QR / NFC).
# Modifiable ensuite depuis la page admin.
SITE_PASSWORD=terrain

# Mot de passe ADMIN (page /admin). CHANGE-LE.
ADMIN_PASSWORD=un-mot-de-passe-admin-solide

# Secret de signature des cookies. Mets une longue chaîne aléatoire :
#   openssl rand -hex 32
SESSION_SECRET=remplace-moi-par-32-octets-aleatoires

# Chemin de la page admin (par défaut /admin). Tu peux le rendre plus discret,
# ex: /gestion-secrete-42
ADMIN_PATH=/admin

# URL publique finale du site (pour générer des QR corrects).
# Laisse vide en local ; en prod mets par ex: https://terrain.mondomaine.fr
PUBLIC_URL=
