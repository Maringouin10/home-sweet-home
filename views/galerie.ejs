<%- include('partials/header') %>

  <section class="page-head">
    <h1>🎬 Galerie & time-lapse</h1>
    <p class="lead">Les projets et chantiers du terrain.</p>
  </section>

  <% if (!cfg.gallery || !cfg.gallery.length) { %>
    <div class="empty">
      <p>Rien à montrer pour l'instant. Reviens bientôt !</p>
    </div>
  <% } else { %>
    <div class="gallery">
      <% cfg.gallery.slice().reverse().forEach(function (g) { %>
        <article class="gallery-item" id="<%= g.id %>">
          <h2><%= g.title %></h2>

          <% if (g.embedUrl) { %>
            <div class="video-frame">
              <iframe src="<%= g.embedUrl %>" loading="lazy" allowfullscreen
                referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
          <% } else if (g.media && g.mediaType === 'video') { %>
            <video controls preload="metadata" src="/media/<%= g.media %>"></video>
          <% } else if (g.media) { %>
            <img src="/media/<%= g.media %>" alt="<%= g.title %>" />
          <% } %>

          <% if (g.description) { %>
            <% g.description.split(/\n{2,}/).forEach(function (para) { %>
              <p><%= para %></p>
            <% }) %>
          <% } %>
        </article>
      <% }) %>
    </div>
  <% } %>

<%- include('partials/footer') %>
