<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Administration — <%= cfg.siteTitle %></title>
  <link rel="stylesheet" href="/static/style.css" />
</head>
<body class="admin">
  <header class="site-header">
    <span class="brand">🔒 Administration</span>
    <nav class="site-nav">
      <a href="/" target="_blank">Voir le site ↗</a>
      <a href="<%= adminPath %>/tags" target="_blank">Imprimer les balises 🖨️</a>
      <a href="<%= adminPath %>/logout" class="muted">Déconnexion</a>
    </nav>
  </header>

  <main class="container admin-main">
    <% if (saved) { %><div class="banner">✔ Enregistré (<%= saved %>).</div><% } %>

    <!-- Pages -->
    <section class="panel">
      <h2>📄 Pages</h2>
      <p class="muted">Chaque page est un article que tu composes avec des blocs (texte, image, vidéo, stats…).</p>
      <ul class="admin-list">
        <% pages.forEach(function (p) { %>
          <li>
            <div class="grow">
              <a class="page-link" href="<%= adminPath %>/pages/<%= p.id %>"><%= p.icon %> <strong><%= p.title %></strong></a>
              <% if (p.isHome) { %><span class="tag">accueil</span><% } %>
              <% if (!p.published) { %><span class="tag warn">masquée</span><% } %>
              <span class="muted small"><%= p.blockCount %> bloc(s) · /<%= p.slug %></span>
            </div>
            <div class="row-actions">
              <form method="post" action="<%= adminPath %>/pages/<%= p.id %>/move"><input type="hidden" name="dir" value="up" /><button class="mini" title="Monter">▲</button></form>
              <form method="post" action="<%= adminPath %>/pages/<%= p.id %>/move"><input type="hidden" name="dir" value="down" /><button class="mini" title="Descendre">▼</button></form>
              <% if (!p.isHome) { %>
                <form method="post" action="<%= adminPath %>/pages/<%= p.id %>/home"><button class="mini" title="Définir comme accueil">🏠</button></form>
              <% } %>
              <a class="btn-link mini" href="<%= adminPath %>/pages/<%= p.id %>">Éditer</a>
              <% if (!p.isHome) { %>
                <form method="post" action="<%= adminPath %>/pages/<%= p.id %>/delete" onsubmit="return confirm('Supprimer la page « <%= p.title %> » ?');"><button class="mini danger">✕</button></form>
              <% } %>
            </div>
          </li>
        <% }) %>
      </ul>
      <form method="post" action="<%= adminPath %>/pages" class="inline-form">
        <input type="text" name="icon" value="📄" maxlength="8" class="icon-input" aria-label="icône" />
        <input type="text" name="title" placeholder="Nom de la nouvelle page" required />
        <button type="submit">+ Créer une page</button>
      </form>
    </section>

    <!-- Sources de données live -->
    <section class="panel">
      <h2>🔌 Données live (URL → JSON)</h2>
      <p class="muted">
        Ajoute une URL qui renvoie du JSON (ex. l'API de tes panneaux solaires).
        Elle est appelée à chaque affichage. Ensuite tu glisses ses variables dans
        tes textes et stats, ex. <code>{{solaire.today}} kWh</code>.
      </p>

      <% if (cfg.sources.length) { %>
        <div class="sources">
          <% cfg.sources.forEach(function (s) { %>
            <div class="source-card">
              <form method="post" action="<%= adminPath %>/sources">
                <input type="hidden" name="id" value="<%= s.id %>" />
                <div class="src-grid">
                  <label>Nom (variable)
                    <input type="text" name="name" value="<%= s.name %>" pattern="[a-zA-Z0-9_]+" required />
                  </label>
                  <label>Rafraîchir (s)
                    <input type="number" name="ttl" value="<%= s.ttl %>" min="2" max="3600" />
                  </label>
                </div>
                <label>URL JSON
                  <input type="url" name="url" value="<%= s.url %>" required />
                </label>
                <label>En-têtes HTTP (optionnel, une par ligne « Clé: valeur »)
                  <textarea name="headers" rows="2" placeholder="Authorization: Bearer xxxxx"><%= s.headers %></textarea>
                </label>
                <div class="row-actions">
                  <button type="submit">Enregistrer</button>
                  <button type="button" class="btn-link mini" data-preview="<%= s.id %>">Tester / voir les variables</button>
                  <button formaction="<%= adminPath %>/sources/<%= s.id %>/delete" formmethod="post" class="mini danger" onclick="return confirm('Supprimer la source « <%= s.name %> » ?');" formnovalidate>Supprimer</button>
                </div>
              </form>
              <div class="preview" id="preview-<%= s.id %>" hidden></div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="muted">Aucune source pour l'instant.</p>
      <% } %>

      <details>
        <summary>Ajouter une source</summary>
        <form method="post" action="<%= adminPath %>/sources">
          <div class="src-grid">
            <label>Nom (variable, ex. « solaire »)
              <input type="text" name="name" pattern="[a-zA-Z0-9_]+" placeholder="solaire" required />
            </label>
            <label>Rafraîchir (s)
              <input type="number" name="ttl" value="30" min="2" max="3600" />
            </label>
          </div>
          <label>URL JSON
            <input type="url" name="url" placeholder="http://192.168.1.50/api/production" required />
          </label>
          <label>En-têtes HTTP (optionnel)
            <textarea name="headers" rows="2" placeholder="Authorization: Bearer xxxxx"></textarea>
          </label>
          <button type="submit">Ajouter la source</button>
        </form>
      </details>
    </section>

    <!-- Balises NFC / QR -->
    <section class="panel">
      <h2>🏷️ Balises NFC / QR</h2>
      <p class="muted">Chaque balise ouvre une page avec le mot de passe déjà inclus.</p>
      <% if (points.length) { %>
        <div class="points">
          <% points.forEach(function (p) { %>
            <div class="point-card">
              <img class="qr" src="<%= adminPath %>/qr/<%= p.id %>.png" alt="QR <%= p.label %>" />
              <div class="point-info">
                <strong><%= p.label %></strong>
                <span class="tag"><%= p.pageTitle %></span>
                <% if (p.note) { %><p class="muted small"><%= p.note %></p><% } %>
                <input class="url-field" type="text" readonly value="<%= p.url %>" onclick="this.select()" />
                <div class="point-actions">
                  <a class="btn-link" href="<%= adminPath %>/qr/<%= p.id %>.png" download>Télécharger le QR</a>
                  <form method="post" action="<%= adminPath %>/points/<%= p.id %>/delete" onsubmit="return confirm('Supprimer la balise ?');"><button class="danger">Supprimer</button></form>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="muted">Aucune balise pour l'instant.</p>
      <% } %>
      <details>
        <summary>Ajouter une balise</summary>
        <form method="post" action="<%= adminPath %>/points">
          <label>Emplacement / nom
            <input type="text" name="label" required placeholder="Ex. Avant la forêt" />
          </label>
          <label>Cette balise ouvre la page…
            <select name="pageId">
              <% pages.forEach(function (p) { %><option value="<%= p.id %>"><%= p.icon %> <%= p.title %></option><% }) %>
            </select>
          </label>
          <label>Note (optionnel)
            <input type="text" name="note" placeholder="Ex. clouée sur le poteau du portail" />
          </label>
          <button type="submit">Créer la balise</button>
        </form>
      </details>
    </section>

    <!-- Réglages -->
    <section class="panel">
      <h2>⚙️ Réglages</h2>
      <form method="post" action="<%= adminPath %>/settings">
        <label>Titre du site
          <input type="text" name="siteTitle" value="<%= cfg.siteTitle %>" maxlength="120" />
        </label>
        <button type="submit">Enregistrer</button>
      </form>
      <form method="post" action="<%= adminPath %>/password" style="margin-top:1rem">
        <label>Mot de passe visiteur (intégré aux QR / NFC, min. 3 caractères)
          <input type="text" name="sitePassword" value="<%= cfg.sitePassword %>" minlength="3" required />
        </label>
        <button type="submit">Changer le mot de passe</button>
      </form>
    </section>
  </main>

  <script src="/static/admin.js"></script>
</body>
</html>
