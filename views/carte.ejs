<%- include('partials/header') %>

  <section class="page-head">
    <h1>🗺️ Carte du terrain</h1>
    <% if (cfg.map.caption) { %><p class="lead"><%= cfg.map.caption %></p><% } %>
  </section>

  <% if (cfg.map.embed) { %>
    <div class="map-frame">
      <iframe src="<%= cfg.map.embed %>" loading="lazy" allowfullscreen
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  <% } else if (cfg.map.image) { %>
    <figure class="map-figure">
      <img src="/media/<%= cfg.map.image %>" alt="Carte du terrain" />
    </figure>
  <% } else { %>
    <div class="empty">
      <p>La carte n'a pas encore été ajoutée.</p>
    </div>
  <% } %>

  <% if (cfg.map.description) { %>
    <section class="prose">
      <% cfg.map.description.split(/\n{2,}/).forEach(function (para) { %>
        <p><%= para %></p>
      <% }) %>
    </section>
  <% } %>

<%- include('partials/footer') %>
